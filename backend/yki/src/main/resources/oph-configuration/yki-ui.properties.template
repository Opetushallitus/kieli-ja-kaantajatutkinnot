application.port=8080

postgresql.url=jdbc:postgresql://{{host_postgresql_yki}}:{{host_postgresql_yki_port}}/yki
postgresql.username={{postgres_app_user}}
postgresql.password={{host_postgresql_yki_app_password}}

virkailija.host.alb={{host_alb}}

virkailija.cas.base-url=https://{{host_cas}}
virkailija.cas.service-url=${virkailija.cas.base-url}/yki/v2/virkailija
virkailija.cas.url=${virkailija.cas.base-url}/cas
virkailija.cas.login-url=${virkailija.cas.base-url}/cas/login

public-base-url={{yki_app_url}}
