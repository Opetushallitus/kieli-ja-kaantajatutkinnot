<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<databaseChangeLog logicalFilePath="migrations.xml"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.33.xsd">

    <property name="blob_type" value="bytea" dbms="postgresql"/>

    <changeSet id="2025-09-18-add-free-registration"  author="jrkkp">
        <createTable tableName="free_registration" ifNotExists="true">
            <column autoIncrement="true" name="free_registration_id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="free_registration_pkey"/>
            </column>
            <column name="source" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="matriculation_exam" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="higher_education_concluded" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="higher_education_enrolled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="eb" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="dia" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="other" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="registration_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2025-11-04-add-free-registration-is_foreign-column" author="pkoivisto">
        <preConditions onFail="CONTINUE">
            <not>
                <columnExists tableName="free_registration" columnName="is_foreign"/>
            </not>
        </preConditions>
        <addColumn tableName="free_registration">
            <column name="is_foreign" type="BOOLEAN" />
        </addColumn>
    </changeSet>

    <changeSet id="2025-11-12-add-free-registration-base-entity" author="jrkkp">
        <preConditions onFail="CONTINUE">
            <not>
                <columnExists tableName="free_registration" columnName="version"/>
            </not>
        </preConditions>
        <addColumn tableName="free_registration">
            <column name="version" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="TEXT"/>
            <column name="modified_by" type="TEXT"/>
            <column name="deleted_by" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
    </changeSet>

    <changeSet id="2025-12-16-add-registration-evaluation" author="pkoivisto">
        <preConditions onFail="CONTINUE">
            <dbms type="postgresql" />
        </preConditions>
        <sql>CREATE TYPE evaluation_state AS ENUM ('EVALUATION_PENDING', 'EVALUATION_COMPLETE', 'REVIEW_PENDING', 'REVIEW_COMPLETE', 'REVIEW_FINALIZED', 'RETAKE_PENDING', 'NO_SHOW', 'ABORTED')</sql>
        <createTable tableName="registration_evaluation">
            <column autoIncrement="true" name="registration_evaluation_id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="registration_evaluation_pkey"/>
            </column>
            <column name="registration_id" type="BIGINT">
                <constraints unique="true" nullable="false" />
            </column>
            <column name="state" type="evaluation_state">
                <constraints nullable="false" />
            </column>
            <column name="version" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="TEXT"/>
            <column name="modified_by" type="TEXT"/>
            <column name="deleted_by" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="registration_evaluation"
                baseColumnNames="registration_id"
                constraintName="fk_registration_evaluation_registration_id"
                referencedTableName="registration"
                referencedColumnNames="id" />
    </changeSet>

    <changeSet id="2025-02-19-add-contact-to-session" author="jrkkp">
        <preConditions onFail="CONTINUE">
            <dbms type="postgresql" />
        </preConditions>
        <addColumn tableName="exam_session">
            <column name="contact_name" type="TEXT"/>
            <column name="contact_email" type="TEXT"/>
            <column name="contact_phone_number" type="TEXT"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-02-16-add-exam-session-tickets" author="lket">
        <preConditions onFail="CONTINUE">
            <dbms type="postgresql" />
        </preConditions>
        <sql>CREATE TYPE exam_session_type AS ENUM ('FULL','READ_SPEAK','LISTEN_WRITE')</sql>
        <sql>CREATE TYPE exam_session_ticket_type AS ENUM ('ALL_PARTS','READ','SPEAK','LISTEN','WRITE')</sql>
        <createTable tableName="exam_session_ticket">
            <column autoIncrement="true" name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="exam_session_ticket_pkey"/>
            </column>
            <column name="exam_date_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="exam_session_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="type" type="exam_session_ticket_type">
                <constraints nullable="false" />
            </column>
            <column name="registration_id" type="BIGINT"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="exam_session_ticket"
                baseColumnNames="exam_date_id"
                constraintName="fk_exam_session_ticket_exam_date"
                referencedTableName="exam_date"
                referencedColumnNames="id" />
        <addForeignKeyConstraint
                baseTableName="exam_session_ticket"
                baseColumnNames="exam_session_id"
                constraintName="fk_exam_session_ticket_exam_session"
                referencedTableName="exam_session"
                referencedColumnNames="id" />
        <addForeignKeyConstraint
                baseTableName="exam_session_ticket"
                baseColumnNames="registration_id"
                constraintName="fk_exam_session_ticket_registration"
                referencedTableName="registration"
                referencedColumnNames="id" />
        <createIndex tableName="exam_session_ticket"
                     indexName="idx_exam_session_ticket_exam_date_id">
            <column name="exam_date_id"/>
        </createIndex>
        <createIndex tableName="exam_session_ticket"
                     indexName="idx_exam_session_ticket_exam_session_id">
            <column name="exam_session_id"/>
        </createIndex>
        <createIndex tableName="exam_session_ticket"
                     indexName="idx_exam_session_ticket_registration_id">
            <column name="registration_id"/>
        </createIndex>
        <addColumn tableName="exam_session">
            <column name="type"
                    type="exam_session_type"
                    defaultValue="FULL">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="exam_date">
            <column name="type"
                    type="exam_session_type"
                    defaultValue="FULL">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addColumn tableName="registration">
            <column name="partial_exam_type"
                    type="exam_session_ticket_type"
                    defaultValue="ALL_PARTS">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="2026-03-12-add-exam-date-exam-type" author="kimmotaskinen-knowit">
        <preConditions onFail="CONTINUE">
            <dbms type="postgresql" />
        </preConditions>
        <createTable tableName="exam_date_exam_type">
            <column name="exam_date_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="exam_type" type="exam_session_type">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="exam_date_exam_type"
                baseColumnNames="exam_date_id"
                constraintName="fk_exam_date_exam_type_exam_date"
                referencedTableName="exam_date"
                referencedColumnNames="id" />
    </changeSet>
    <changeSet id="2026-03-19-exam-date-type-to-exam-type" author="kimmotaskinen-knowit">
        <preConditions onFail="CONTINUE">
            <dbms type="postgresql" />
        </preConditions>
        <dropTable tableName="exam_date_exam_type" />
        <renameColumn tableName="exam_date" oldColumnName="type" newColumnName="exam_type" />
        <sql>ALTER TABLE exam_date ALTER COLUMN exam_type TYPE VARCHAR(50) USING exam_type::text</sql>
    </changeSet>

    <changeSet id="2026-04-10-create-shedlock-table" author="miikavonbell">
        <createTable tableName="shedlock">
            <column name="name" type="VARCHAR(64)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="lock_until" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="locked_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="locked_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2026-04-09-add-max-participants-partial-exam" author="lket">
        <sql>ALTER TABLE exam_session ALTER COLUMN max_participants DROP NOT NULL</sql>
        <addColumn tableName="exam_session">
            <column name="max_participants_read_listen" type="INTEGER"/>
            <column name="max_participants_speak_write" type="INTEGER"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-05-05-add-exam-session-start-times" author="jrkkp">
        <addColumn tableName="exam_session">
            <column name="start_time" type="TEXT"/>
            <column name="start_time_read_listen" type="TEXT"/>
            <column name="start_time_speak_write" type="TEXT"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-05-21-add-exam-session-organizer-index" author="jrkkp">
        <createIndex tableName="exam_session" indexName="exam_session_organizer_id_idx">
            <column name="organizer_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026-05-28-add_spring_session_table" author="jrkkp">
        <createTable tableName="spring_session">
            <column name="primary_id" type="CHAR(36)">
                <constraints
                    nullable="false"
                    primaryKey="true"
                    primaryKeyName="spring_session_pk"
                />
            </column>
            <column name="session_id" type="CHAR(36)">
                <constraints
                    nullable="false"
                    unique="true"
                    uniqueConstraintName="spring_session_id_idx"
                />
            </column>
            <column name="creation_time" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="last_access_time" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="max_inactive_interval" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="expiry_time" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="principal_name" type="VARCHAR(100)"/>
        </createTable>

        <createIndex tableName="spring_session" indexName="spring_session_expires_idx">
            <column name="expiry_time"/>
        </createIndex>

        <createIndex tableName="spring_session" indexName="spring_session_principal_idx">
            <column name="principal_name"/>
        </createIndex>

        <createTable tableName="spring_session_attributes">
            <column name="session_primary_id" type="CHAR(36)">
                <constraints
                    foreignKeyName="spring_session_attributes_fk"
                    referencedTableName="spring_session"
                    referencedColumnNames="primary_id"
                    deleteCascade="true"
                    nullable="false"
                />
            </column>
            <column name="attribute_name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="attribute_bytes" type="${blob_type}">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
            constraintName="spring_session_attributes_pk"
            tableName="spring_session_attributes"
            columnNames="session_primary_id, attribute_name"
        />
    </changeSet>

    <changeSet id="2026-05-28-cas-session-ticket" author="jrkkp">
        <createTable tableName="cas_ticket">
            <column name="session_id" type="VARCHAR(255)">
                <constraints
                    nullable="false"
                    unique="true"
                    uniqueConstraintName="cas_ticket_session_id_uniq_idx"
                />
            </column>
            <column name="ticket" type="VARCHAR(255)">
                <constraints
                    nullable="false"
                    unique="true"
                    uniqueConstraintName="cas_ticket_ticket_uniq_idx"
                />
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2026-07-21-add-exam-session-statistics" author="miikavonbell">
        <preConditions onFail="CONTINUE">
            <not>
                <tableExists tableName="exam_session_statistics"/>
            </not>
        </preConditions>
        <createTable tableName="exam_session_statistics">
            <column autoIncrement="true" name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="exam_session_statistics_pkey"/>
            </column>
            <column name="exam_session_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="participants" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="queue" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="max_participant_count" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="max_queue_count" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="max_participants_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="max_queue_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="last_processed_event_id" type="BIGINT"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="exam_session_statistics"
                baseColumnNames="exam_session_id"
                constraintName="fk_exam_session_statistics_exam_session"
                referencedTableName="exam_session"
                referencedColumnNames="id" />
        <createIndex tableName="exam_session_statistics" indexName="exam_session_statistics_exam_session_id">
            <column name="exam_session_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026-07-30-create-email-table" author="miikavonbell">
        <preConditions onFail="CONTINUE">
            <not>
                <tableExists tableName="email"/>
            </not>
        </preConditions>
        <createTable tableName="email">
            <column autoIncrement="true" name="email_id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="email_pkey"/>
            </column>
            <column name="version" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="TEXT"/>
            <column name="modified_by" type="TEXT"/>
            <column name="deleted_by" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="email_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="recipient_name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="recipient_address" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="subject" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="body" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="sent_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="ext_id" type="TEXT"/>
            <column name="error" type="TEXT"/>
        </createTable>
    </changeSet>

    <changeSet id="2026-07-30-create-email-attachment-table" author="miikavonbell">
        <preConditions onFail="CONTINUE">
            <not>
                <tableExists tableName="email_attachment"/>
            </not>
        </preConditions>
        <createTable tableName="email_attachment">
            <column autoIncrement="true" name="email_attachment_id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="email_attachment_pkey"/>
            </column>
            <column name="version" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="TEXT"/>
            <column name="modified_by" type="TEXT"/>
            <column name="deleted_by" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="email_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="content_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="data" type="${blob_type}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="email_attachment"
                baseColumnNames="email_id"
                constraintName="fk_email_attachment_email"
                referencedTableName="email"
                referencedColumnNames="email_id" />
    </changeSet>

    <changeSet id="2026-08-17-payment-table" author="jrkkp">
        <createTable tableName="payment">
            <column autoIncrement="true" name="payment_id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="payment_id_pkey"/>
            </column>
            <column name="enrollment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_id" type="TEXT"/>
            <column name="reference" type="TEXT"/>
            <column name="payment_url" type="TEXT"/>
            <column name="payment_status" type="TEXT"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="payment" baseColumnNames="registration_id"
                                 referencedTableName="registration" referencedColumnNames="registration_id"
                                 constraintName="fk_payment_registration"
                                 onDelete="NO ACTION" onUpdate="NO ACTION"/>
    </changeSet>
</databaseChangeLog>
