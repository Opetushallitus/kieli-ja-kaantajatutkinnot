<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<databaseChangeLog logicalFilePath="migrations.xml"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <property name="blob_type" value="bytea" dbms="postgresql"/>
    <property name="blob_type" value="blob" dbms="hsqldb"/>

    <changeSet id="2025-09-17-add-registration-hsqldb" author="jrkkp">
        <preConditions onFail="CONTINUE">
            <dbms type="hsqldb"/>
        </preConditions>
        <createTable tableName="registration">
            <column autoIncrement="true" name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="registration_pkey"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2025-09-18-add-free-registration" author="jrkkp">
        <createTable tableName="free_registration">
            <column autoIncrement="true" name="free_registration_id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="free_registration_pkey"/>
            </column>
            <column name="source" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="approved" type="BOOLEAN"/>
            <column name="comment" type="TEXT"/>
            <column name="matriculation_exam" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="higher_education_concluded" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="higher_education_enrolled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="eb" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="dia" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="other" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="registration_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2025-10-07-add-free-registration-attachments" author="jrkkp">
        <createTable tableName="free_attachment">
            <column autoIncrement="true" name="free_attachment_id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="free_attachment_pkey"/>
            </column>
            <column name="free_registration_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="key" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uploaded_file_attachment_key_uniq_idx"/>
            </column>
            <column name="filename" type="TEXT">
                <constraints nullable="false" />
            </column>
            <column name="size" type="INT">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2025-10-09-add-free-registration-comments" author="jrkkp">
        <createTable tableName="free_comment">
            <column autoIncrement="true" name="free_comment_id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="free_comment_pkey"/>
            </column>
            <column name="free_registration_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="TEXT">
                <constraints nullable="false" />
            </column>
            <column name="version" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="TEXT"/>
            <column name="modified_by" type="TEXT"/>
            <column name="deleted_by" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>

    <changeSet id="2025-10-20-add-free-supplement-request" author="jrkkp">
        <createTable tableName="free_supplement_req">
            <column autoIncrement="true" name="free_supplement_req_id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="free_supplement_req__pkey"/>
            </column>
            <column name="free_registration_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="TEXT">
                <constraints nullable="false" />
            </column>
            <column name="due_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="TEXT"/>
            <column name="modified_by" type="TEXT"/>
            <column name="deleted_by" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>
    <changeSet id="2025-10-22-create-awaiting-approval-registration-state" author="jrkkp" runInTransaction="false">
        <sql dbms="postgresql"><![CDATA[
            ALTER TYPE registration_state ADD VALUE 'AWAITING_APPROVAL';
        ]]></sql>
    </changeSet>
    <changeSet id="2025-10-22-add-assessment-date" author="jrkkp">
        <addColumn tableName="free_registration">
            <column name="assessment_date" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
