<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<databaseChangeLog logicalFilePath="migrations.xml"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <property name="blob_type" value="bytea" dbms="postgresql"/>
    <property name="blob_type" value="blob" dbms="hsqldb"/>

    <changeSet id="2025-09-17-add-registration-hsqldb" author="jrkkp">
        <preConditions onFail="CONTINUE">
            <dbms type="hsqldb"/>
        </preConditions>
        <createTable tableName="registration">
            <column autoIncrement="true" name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="registration_pkey"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2025-09-18-add-free-registration" author="jrkkp">
        <createTable tableName="free_registration">
            <column autoIncrement="true" name="free_registration_id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="free_registration_pkey"/>
            </column>
            <column name="source" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="matriculation_exam" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="higher_education_concluded" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="higher_education_enrolled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="eb" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="dia" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="other" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="registration_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2025-11-10-add-person-hsqldb" author="jrkkp">
        <preConditions onFail="CONTINUE">
            <dbms type="hsqldb"/>
        </preConditions>
        <createTable tableName="person">
            <column name="oid" type="VARCHAR(255)">
                <constraints primaryKey="true" primaryKeyName="person_pkey"/>
            </column>
            <column name="first_name" type="TEXT" />
            <column name="last_name" type="TEXT" />
            <column name="email" type="TEXT" />
            <column name="nationality_code" type="TEXT" />
            <column name="phone_number" type="TEXT" />
            <column name="post_office" type="TEXT" />
            <column name="street_address" type="TEXT" />
            <column name="zip" type="TEXT" />
        </createTable>
    </changeSet>

    <changeSet id="2025-11-10-add-registration-columns-hsqldb" author="jrkkp">
        <preConditions onFail="CONTINUE">
            <dbms type="hsqldb"/>
        </preConditions>
        <addColumn tableName="registration">
            <column name="exam_session_id" type="BIGINT"/>
            <column name="kind" type="TEXT"/>
            <column name="person_oid" type="TEXT"/>
            <column name="state" type="TEXT"/>
        </addColumn>
    </changeSet>

    <changeSet id="2025-11-04-add-free-registration-is_foreign-column" author="pkoivisto">
        <addColumn tableName="free_registration">
            <column name="is_foreign" type="BOOLEAN" />
        </addColumn>
    </changeSet>

    <changeSet id="2025-11-12-add-free-registration-base-entity" author="jrkkp">
        <addColumn tableName="free_registration">
            <column name="version" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="TEXT"/>
            <column name="modified_by" type="TEXT"/>
            <column name="deleted_by" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="modified_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
