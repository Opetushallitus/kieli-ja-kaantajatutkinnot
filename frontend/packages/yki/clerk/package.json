{
  "name": "@opetushallitus/kieli-ja-kaantajatutkinnot.yki.clerk",
  "description": "Yleiset kielitutkinnot (YKI) Clerk UI",
  "license": "MIT",
  "main": "index.js",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "repository": "https://github.com/Opetushallitus/kieli-ja-kaantajatutkinnot",
  "scripts": {
    "yki:clerk:build": "yarn g:webpack --env prod",
    "yki:clerk:eslint": "yarn g:eslint --fix \"./src/**/*.{js,jsx,ts,tsx,json}\"",
    "yki:clerk:exportlint": "yarn g:exportlint --excludePathsFromReport=public",
    "yki:clerk:format": "yarn g:prettier --check \"./src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "yki:clerk:format:write": "yarn g:prettier --write \"./src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "yki:clerk:lint": "yarn yki:clerk:eslint && yarn yki:clerk:tslint && yarn yki:clerk:stylelint && yarn yki:clerk:exportlint",
    "yki:clerk:qa": "yarn yki:clerk:lint && yarn yki:clerk:format && yarn yki:clerk:test:jest && yarn yki:clerk:start:ci",
    "yki:clerk:start": "yarn g:webpack serve --config webpack.config.js --env proxy=http://localhost:8083",
    "yki:clerk:start:msw": "yarn g:webpack serve --config webpack.config.js",
    "yki:clerk:start:ci": "yarn g:webpack serve --env cypress --env prod --config webpack.config.js --no-open --no-client-overlay",
    "yki:clerk:start:docker-compose": "yarn g:webpack serve --config webpack.config.js --env proxy=http://yki-backend:8080 --env docker",
    "yki:clerk:stylelint": "yarn g:stylelint --fix \"./src/**/*.scss\"",
    "yki:clerk:test:cypress": "TZ=Europe/Helsinki yarn g:cypress run",
    "yki:clerk:test:cypress:open": "TZ=Europe/Helsinki yarn g:cypress open",
    "yki:clerk:test:jest": "yarn g:jest",
    "yki:clerk:tslint": "yarn g:tsc --pretty --noEmit"
  },
  "dependencies": {
    "shared": "npm:@opetushallitus/kieli-ja-kaantajatutkinnot.shared@1.14.1"
  },
  "devDependencies": {
    "multer": "^2.1.1"
  }
}
